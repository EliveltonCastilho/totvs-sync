# Conexão Oracle. Copie para .env e preencha — .env está no .gitignore.
#
# Nenhuma credencial tem valor padrão no código: se faltar alguma destas, o
# programa falha na largada dizendo exatamente qual.

ORACLE_USER=meu_usuario
ORACLE_PASSWORD=
# Banco comum:            host:porta/serviço
# Autonomous Database:    o alias do tnsnames.ora (ex.: saas_high)
ORACLE_DSN=localhost:1521/FREEPDB1

# Opcional: esquema dos objetos, se diferente do esquema do usuário.
# ORACLE_SCHEMA=

# Só para Autonomous Database configurado com mTLS obrigatório. Se o banco aceita
# TLS simples (mTLS "not required"), deixe as duas linhas comentadas.
# ORACLE_WALLET_DIR=/opt/oracle/wallet
# ORACLE_WALLET_PASSWORD=
